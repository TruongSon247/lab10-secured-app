<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><h2>Danh sách sinh viên</h2><form method="get" action="${pageContext.request.contextPath}/sinh-vien"><input name="keyword" value="${param.keyword}" placeholder="Tìm kiếm"><button>Tìm</button></form><p><a href="${pageContext.request.contextPath}/views/sinhvien/form.jsp">Thêm</a> | <a href="${pageContext.request.contextPath}/dashboard.jsp">Dashboard</a></p><table border="1" cellpadding="6"><tr><th>ID</th><th>Mã</th><th>Họ tên</th><th>Email</th><th>Lớp</th><th>Thao tác</th></tr><c:forEach var="v" items="${dsSinhVien}"><tr><td>${v.id}</td><td>${v.maSinhVien}</td><td>${v.hoTen}</td><td>${v.email}</td><td>${v.lop}</td><td><a href="${pageContext.request.contextPath}/sinh-vien?action=edit&id=${v.id}">Sửa</a> <a href="${pageContext.request.contextPath}/sinh-vien?action=delete&id=${v.id}">Xóa</a></td></tr></c:forEach></table>
