<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><h2>Quản lý sách</h2><p><a href="${pageContext.request.contextPath}/sach?action=new">Thêm sách</a></p><form method="get" action="${pageContext.request.contextPath}/sach"><input name="keyword" placeholder="Tìm kiếm"><button>Tìm</button></form><table border="1"><tr><th>Mã</th><th>Tên</th><th>Tác giả</th><th>Thể loại</th><th>Số lượng</th><th>Thao tác</th></tr><c:forEach var="x" items="${items}"><tr><td>${x.maSach}</td><td>${x.tenSach}</td><td>${x.tacGia}</td><td>${x.theLoai}</td><td>${x.soLuong}</td><td><a href="${pageContext.request.contextPath}/sach?action=edit&id=${x.id}">Sửa</a> <a href="${pageContext.request.contextPath}/sach?action=delete&id=${x.id}">Xóa</a></td></tr></c:forEach></table>
