<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><h2>Quản lý sản phẩm</h2><p><a href="${pageContext.request.contextPath}/san-pham?action=new">Thêm sản phẩm</a></p><form method="get" action="${pageContext.request.contextPath}/san-pham"><input name="keyword" placeholder="Tìm kiếm"><button>Tìm</button></form><table border="1"><tr><th>Mã</th><th>Tên</th><th>Giá</th><th>Số lượng tồn</th><th>Thao tác</th></tr><c:forEach var="x" items="${items}"><tr><td>${x.maSanPham}</td><td>${x.tenSanPham}</td><td>${x.gia}</td><td>${x.soLuongTon}</td><td><a href="${pageContext.request.contextPath}/san-pham?action=edit&id=${x.id}">Sửa</a> <a href="${pageContext.request.contextPath}/san-pham?action=delete&id=${x.id}">Xóa</a></td></tr></c:forEach></table>
